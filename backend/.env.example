# Copy to .env for running the API outside Docker (`make run`).
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info
# Runtime role: no superuser, no BYPASSRLS.
DATABASE_URL=postgres://menuly_app:menuly_app@localhost:5432/menuly?sslmode=disable
# Schema owner, used only for migrations.
MIGRATE_DATABASE_URL=postgres://menuly:menuly@localhost:5432/menuly?sslmode=disable
MIGRATE_ON_START=false
JWT_SECRET=dev-only-secret-change-me-in-production-0123456789
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
CORS_ALLOWED_ORIGINS=http://localhost:4200
PUBLIC_MENU_URL=https://{tenant}.menuly.app/{venue}

# OCR import (menu photos/PDFs -> draft menu). OCR_PROVIDER: anthropic,
# openai or mistral; empty picks the first one with a key. Without any key,
# uploads are accepted but every page fails with "OCR is not configured".
OCR_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Any OpenAI-compatible API (image input + json_schema), default api.openai.com.
OPENAI_BASE_URL=
MISTRAL_API_KEY=
# Empty = provider default (claude-haiku-5-5 / gpt-6-luna / mistral-small-2603).
OCR_MODEL=
# Re-reads pages whose result looks wrong. Empty = provider default
# (claude-opus-5-5 / gpt-6.1-terra / mistral-large-2512); none = off.
OCR_FALLBACK_MODEL=
OCR_EFFORT=medium
# Pages read in parallel by this process; 0 = only enqueue (separate worker).
OCR_WORKERS=2
# Uploaded files: S3-compatible storage when S3_ENDPOINT is set, else a folder.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=menuly
S3_USE_SSL=false
STORAGE_DIR=./data/uploads

# Start of image URLs returned by POST /v1/media/images.
PUBLIC_API_URL=http://localhost:8080
# Web app base for links in emails (/invite, /reset-password).
APP_URL=http://localhost:4200
# Email (invites, password reset). Without SMTP_HOST emails are only logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Menuly <no-reply@menuly.app>
