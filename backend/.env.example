# Copy to .env for running the API outside Docker (`make run`).
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info
# Runtime role: no superuser, no BYPASSRLS.
DATABASE_URL=postgres://menuly_app:menuly_app@localhost:5432/menuly?sslmode=disable
# Schema owner, used only for migrations.
MIGRATE_DATABASE_URL=postgres://menuly:menuly@localhost:5432/menuly?sslmode=disable
MIGRATE_ON_START=false
JWT_SECRET=dev-only-secret-change-me-in-production-0123456789
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
CORS_ALLOWED_ORIGINS=http://localhost:4200
PUBLIC_MENU_URL=https://{tenant}.menuly.app/{venue}

# OCR import (menu photos/PDFs -> draft menu). Without a key, uploads are
# accepted but every page fails with "OCR is not configured".
ANTHROPIC_API_KEY=
OCR_MODEL=claude-haiku-5-5
# Re-reads pages whose result looks wrong (unreadable prices, nothing found).
OCR_FALLBACK_MODEL=claude-opus-5-5
OCR_EFFORT=medium
# Pages read in parallel by this process; 0 = only enqueue (separate worker).
OCR_WORKERS=2
# Uploaded files: S3-compatible storage when S3_ENDPOINT is set, else a folder.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=menuly
S3_USE_SSL=false
STORAGE_DIR=./data/uploads
