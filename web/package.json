    "@angular/platform-server": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@angular/ssr": "^22.2.7",
    "@lucide/angular": "^1.69.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
